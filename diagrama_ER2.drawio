        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    UTILIZATORI {\n        int id_utilizator PK\n        string nume\n        string parola_hash\n        enum rol\n    }\n\n    FURNIZORI {\n        int id_furnizor PK\n        string denumire\n        string telefon\n    }\n\n    INGREDIENTE {\n        int id_ingredient PK\n        string nume\n        string unitate_masura\n        decimal stoc_curent\n        decimal prag_minim\n    }\n\n    LOTURI {\n        int id_lot PK\n        decimal cantitate_ramasa\n        date data_receptiei\n        date data_expirarii\n        int id_ingredient FK\n        int id_furnizor FK\n    }\n\n    RETETE {\n        int id_reteta PK\n        string denumire\n        int portii_baza\n        enum sursa\n        enum stare\n        int id_utilizator FK\n    }\n\n    RETETE_INGREDIENTE {\n        int id_reteta PK_FK\n        int id_ingredient PK_FK\n        decimal cantitate\n    }\n\n    PRODUSE {\n        int id_produs PK\n        string denumire\n        decimal pret_vanzare\n        boolean activ\n        int id_reteta FK\n    }\n\n    CLIENTI {\n        int id_client PK\n        string nume\n        string telefon\n    }\n\n    COMENZI {\n        int id_comanda PK\n        enum tip\n        datetime data_livrare\n        enum stare\n        string model_dorit\n        string text_personalizat\n        int id_client FK\n    }\n\n    COMENZI_DETALII {\n        int id_detaliu PK\n        int cantitate\n        int id_comanda FK\n        int id_produs FK\n    }\n\n    PRODUCTIE {\n        int id_sarcina PK\n        enum stare\n        date data_productie\n        int id_detaliu FK\n        int id_comanda FK\n        int id_utilizator FK\n    }\n\n    GENERARI_AI {\n        int id_generare PK\n        text ingrediente_trimise\n        text raspuns_ai\n        datetime data_generarii\n        int id_utilizator FK\n        int id_reteta FK\n    }\n\n    FURNIZORI -- LOTURI : \&quot;1 la N\&quot;\